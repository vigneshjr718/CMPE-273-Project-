# Copy to .env for running ONE seller outside Docker. In compose, values come from
# config/seller-N.env + the DB password from infra/.env.

SELLER_ID=seller-1
SELLER_NAME=Seller One
PORT=8101
DELIVERY_HOURS=24
PRICE_MULTIPLIER=1.00

SEED_ON_STARTUP=true
SEED_BASE=20261124

# Either a full URL ...
# DATABASE_URL=postgresql://seller1:CHANGE_ME@localhost:5432/seller1_db
# ... or the parts:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seller1_db
DB_USER=seller1
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=5000

# Team-only. Leave empty to disable /admin/* (faults, demo delivery controls, inventory).
ADMIN_TOKEN=

LOG_LEVEL=INFO
