# LOCAL synthetic-data development only. Role/password must match C's infra/db-init/init.sql.
# Inside compose these are overridden by infra/docker-compose.yml (postgres:5432, kafka:9092).
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:local_only@localhost:5432/tracker_db
TRACKER_LOG_LEVEL=INFO
TRACKER_PORT=8004
# Apply Alembic migrations on startup (single tracker replica).
TRACKER_RUN_MIGRATIONS=true

# Kafka (topics/keys: contracts/events/topics.md)
TRACKER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRACKER_ORDER_TOPIC=order.created
TRACKER_WORKFLOW_TOPIC=workflow.events
TRACKER_CONSUMER_GROUP=tracker-v1
TRACKER_CONSUMER_ENABLED=true
# Unparseable messages: dead_letter (default) = record in dead_letter_events, keep consuming;
# stop = halt on them without committing the offset (for debugging a producer).
TRACKER_INVALID_EVENT_POLICY=dead_letter
