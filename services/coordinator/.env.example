# LOCAL synthetic-data development only. Coordinate actual credentials with C/D.
COORDINATOR_DATABASE_URL=postgresql+asyncpg://coordinator:local_only@localhost:5432/coordinator_db
COORDINATOR_LOG_LEVEL=INFO
COORDINATOR_DEPENDENCY_TIMEOUT_SECONDS=3
COORDINATOR_SELLER_TIMEOUT_SECONDS=2
COORDINATOR_MAX_SELLER_CONCURRENCY=5
COORDINATOR_SELLER_URLS='{"seller-1":"http://localhost:8101","seller-2":"http://localhost:8102","seller-3":"http://localhost:8103","seller-4":"http://localhost:8104","seller-5":"http://localhost:8105"}'
# Proposed until D supplies final topic/broker configuration.
COORDINATOR_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
COORDINATOR_INCOMING_TOPIC=order.created
COORDINATOR_WORKFLOW_TOPIC=workflow.events
COORDINATOR_CONSUMER_GROUP=coordinator-v1
# Existing saved outbox rows retain their original destination topic.
COORDINATOR_OUTBOX_BATCH_SIZE=50
COORDINATOR_OUTBOX_POLL_SECONDS=1
COORDINATOR_KAFKA_OPERATION_TIMEOUT_SECONDS=10
COORDINATOR_DELIVERY_POLL_SECONDS=10
COORDINATOR_DELIVERY_POLL_CONCURRENCY=5

# Provisional cancellation/fencing driver; unresolved outcomes remain pending.
COORDINATOR_CANCELLATION_MAX_CYCLES=3
COORDINATOR_CANCELLATION_BACKOFF_SECONDS=1

# Incoming order consumer; defaults preserve manual, bounded intake.
COORDINATOR_INCOMING_BATCH_SIZE=10
COORDINATOR_INCOMING_POLL_MS=1000
COORDINATOR_INCOMING_MAX_EVENT_BYTES=1048576
COORDINATOR_INCOMING_DATABASE_TIMEOUT_SECONDS=10
