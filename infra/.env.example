# Copy to infra/.env before the first run (cp infra/.env.example infra/.env). Never commit infra/.env.
# LOCAL synthetic-data values only. Cloud values are set on the VM by D.

# Postgres superuser "postgres". Set when the volume is first created; also used by db-init.
POSTGRES_PASSWORD=postgres_local_only

# One password per service role. db-init passes each to infra/db-init/*.sql as the psql
# variable <name>_db_password, and compose builds that service's DATABASE_URL from it.
# Use hex values on real deployments: openssl rand -hex 16
ORDER_DB_PASSWORD=local_only
COORDINATOR_DB_PASSWORD=local_only
TRACKER_DB_PASSWORD=local_only
SELLER1_DB_PASSWORD=local_only
SELLER2_DB_PASSWORD=local_only
SELLER3_DB_PASSWORD=local_only
SELLER4_DB_PASSWORD=local_only
SELLER5_DB_PASSWORD=local_only

# Public port for the frontend/proxy.
PUBLIC_HTTP_PORT=80

# Dev override host ports (change if they clash with something on your laptop).
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
