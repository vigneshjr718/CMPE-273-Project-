# Copy to infra/.env before the first run (cp infra/.env.example infra/.env). Never commit infra/.env.
# LOCAL synthetic-data values only. Cloud values are set on the VM by D.

# Postgres superuser (container bootstrap only; services use their own roles
# from C's infra/db-init/init.sql).
POSTGRES_PASSWORD=postgres_local_only

# Per-service connection strings. Role names/passwords must match C's init.sql.
COORDINATOR_DATABASE_URL=postgresql+asyncpg://coordinator:local_only@postgres:5432/coordinator_db
TRACKER_DATABASE_URL=postgresql+asyncpg://tracker:local_only@postgres:5432/tracker_db

# Public port for the frontend/proxy.
PUBLIC_HTTP_PORT=80

# Dev override host ports (change if they clash with something on your laptop).
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
